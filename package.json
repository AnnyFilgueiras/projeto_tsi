{
  "name": "panelada-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @panelada/api test:integration",
    "contracts:lint": "redocly lint docs/fase2/04-contratos/openapi.yaml",
    "contracts:generate": "openapi-typescript docs/fase2/04-contratos/openapi.yaml -o apps/api/src/shared/openapi.generated.ts && openapi-typescript docs/fase2/04-contratos/openapi.yaml -o apps/mobile/src/core/network/openapi.generated.ts && prettier --write apps/api/src/shared/openapi.generated.ts apps/mobile/src/core/network/openapi.generated.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "db:migrate": "pnpm --filter @panelada/api db:migrate",
    "db:seed": "pnpm --filter @panelada/api db:seed",
    "db:reset": "pnpm --filter @panelada/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@redocly/cli": "^1.34.5",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import-x": "^4.10.0",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.6.1",
    "pnpm": "10.11.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0"
  },
  "pnpm": {
    "overrides": {
      "react-dom": "18.3.1"
    }
  }
}
