# Run migrations and the seed from your machine against Cloud 4C (Supabase), see docs/dev/DEPLOY.md.
# Copy to `.env.cloud` (git-ignored), fill in, then:
#   set -a; . ./.env.cloud; set +a; pnpm db:migrate && pnpm db:seed
# Never paste these values in chats, issues or commits.

# Supabase > Connect > Session pooler (IPv4). The direct connection is IPv6-only.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Supabase > Database settings > SSL configuration > Download certificate (PEM content).
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# Seed photos go straight to Supabase Storage (private bucket).
PHOTO_STORAGE_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_PHOTOS_BUCKET=dish-photos

# Curator account created by the seed (use a strong, unique password in the cloud).
CURATOR_EMAIL=curador@panelada.local
CURATOR_PASSWORD=<strong-password>
