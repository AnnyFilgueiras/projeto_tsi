  "filterCandidates": [
    {
      "id": "FC-01",
      "trace": "RN16 / US01",
      "description": "user without restrictions keeps recipes across all three allergen states in original order",
      "input": {
        "recipes": [
          { "id": "dish-verified", "allergens": ["ovo"], "allergenState": "verified" },
          {
            "id": "dish-source-declared",
            "allergens": ["leite", "lactose"],
            "allergenState": "source_declared"
          },
          { "id": "dish-unverified", "allergens": [], "allergenState": "unverified" }
        ],
        "restrictions": []
      },
      "expectedIds": ["dish-verified", "dish-source-declared", "dish-unverified"]
    },
    {
      "id": "FC-02",
      "trace": "RN08 / RN10 / A06",
      "description": "user with single restriction keeps only verified compatible recipes and excludes incompatible, source_declared, unverified, and unconfirmed empty",
      "input": {
        "recipes": [
          { "id": "dish-safe-verified", "allergens": ["ovo"], "allergenState": "verified" },
          {
            "id": "dish-safe-free",
            "allergens": [],
            "allergenState": "verified",
            "confirmedAllergenFree": true
          },
          {
            "id": "dish-incompatible",
            "allergens": ["amendoim"],
            "allergenState": "verified"
          },
          {
            "id": "dish-source-declared",
            "allergens": ["ovo"],
            "allergenState": "source_declared"
          },
          { "id": "dish-unverified", "allergens": [], "allergenState": "unverified" },
          { "id": "dish-empty-unconfirmed", "allergens": [], "allergenState": "verified" }
        ],
        "restrictions": ["amendoim"]
      },
      "expectedIds": ["dish-safe-verified", "dish-safe-free"]
    },
    {
      "id": "FC-03",
      "trace": "RN08 / RN10 / A06",
      "description": "user with multiple restrictions excludes any recipe matching any restriction while keeping verified lactose-free dairy for lactose-only restriction",
      "input": {
        "recipes": [
          {
            "id": "dish-lactose-free-dairy",
            "allergens": ["leite"],
            "allergenState": "verified"
          },
          {
            "id": "dish-regular-dairy",
            "allergens": ["leite", "lactose"],
            "allergenState": "verified"
          },
          {
            "id": "dish-gluten",
            "allergens": ["trigo_centeio_cevada_aveia"],
            "allergenState": "verified"
          },
          { "id": "dish-fish", "allergens": ["peixe"], "allergenState": "verified" }
        ],
        "restrictions": ["lactose", "trigo_centeio_cevada_aveia"]
      },
      "expectedIds": ["dish-lactose-free-dairy", "dish-fish"]
    },
    {
      "id": "FC-04",
      "trace": "US01",
      "description": "empty candidate list returns empty array",
      "input": {
        "recipes": [],
        "restrictions": ["amendoim"]
      },
      "expectedIds": []
    }
  ],
