# Local development environment variables for Panelada.
# Copy to `.env` if you need overrides on the host. Never commit real secrets.

NODE_ENV=development
TZ=UTC
PORT=3000
HOST=0.0.0.0

# PostgreSQL running inside Docker Compose (never install Postgres on host).
POSTGRES_USER=panelada
POSTGRES_PASSWORD=panelada
POSTGRES_DB=panelada_dev
POSTGRES_PORT=5432

# Host-side connection URLs (for db:reset, db:migrate, db:seed, test:integration).
DATABASE_URL=postgresql://panelada:panelada@localhost:5432/panelada_dev
TEST_DATABASE_URL=postgresql://panelada:panelada@localhost:5432/panelada_test

# Auth & application-layer encryption (ADR-006, ADR-007) — dev-only defaults, override in production!
JWT_SECRET=panelada-dev-only-jwt-secret-change-in-prod-0001
FIELD_ENCRYPTION_KEY=QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=
FIELD_ENCRYPTION_KEY_VERSION=1

# Curator seed credentials used by db:seed and Bruno curation collection (ADR-007).
CURATOR_EMAIL=curador@panelada.local
CURATOR_PASSWORD=panelada-curador-dev

# Photo storage adapter (P02f, ADR-012): "local" (Docker volume) or "supabase" (Cloud 4C REST API).
PHOTO_STORAGE_DRIVER=local
PHOTO_STORAGE_DIR=/data/photos
# Required only when PHOTO_STORAGE_DRIVER=supabase:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# SUPABASE_PHOTOS_BUCKET=dish-photos

# Log verbosity for Pino (fatal, error, warn, info, debug, trace, silent).
LOG_LEVEL=info
