meta {
  name: Importação assistida
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/curation/imports
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "text": "Panqueca de aveia: misture 1 xícara de aveia, 1 ovo e 1 xícara de leite. Aqueça uma frigideira e doure dos dois lados por 3 minutos.",
    "sourceName": "Receita da dupla (exemplo de importação)",
    "sourceUrl": "https://example.org/panqueca-de-aveia"
  }
}

vars:post-response {
  assistedProposalId: res.body.id
}

assert {
  res.status: eq 201
  res.body.publicationState: eq proposed
  res.body.origin: eq ai
}
