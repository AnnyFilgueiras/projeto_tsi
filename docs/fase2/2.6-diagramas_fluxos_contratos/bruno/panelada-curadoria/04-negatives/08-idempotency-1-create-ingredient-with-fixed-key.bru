meta {
  name: Idempotência 1: criar ingrediente com chave fixa
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/curation/ingredients
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{fixedKey}}
}

body:json {
  {
    "name": "Ingrediente idempotente",
    "allergens": [
      "ovo"
    ]
  }
}

script:pre-request {
  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      var r = Math.random() * 16 | 0;
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }
  bru.setVar('fixedKey', uuid());
}

vars:post-response {
  idemIngredientId: res.body.id
}

assert {
  res.status: eq 201
}
