meta {
  name: Idempotência 3: mesma chave com corpo diferente é rejeitada
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/curation/ingredients
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{fixedKey}}
}

body:json {
  {
    "name": "Outro nome",
    "allergens": [
      "ovo"
    ]
  }
}

assert {
  res.status: eq 422
}

tests {
  test("tipo do problema contém key-reused", function() {
    expect(res.body.type).to.contain("key-reused");
  });
}
