meta {
  name: Enviar receita manual
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/curation/recipes
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "name": "Crepe simples",
    "cuisineId": "10000000-0000-4000-8000-000000000002",
    "baseDishId": null,
    "prepTimeMinutes": 30,
    "difficulty": "easy",
    "ingredients": [
      {
        "ingredientId": "20000000-0000-4000-8000-000000000002",
        "quantity": "1",
        "unit": "xícara"
      },
      {
        "ingredientId": "20000000-0000-4000-8000-000000000008",
        "quantity": "2",
        "unit": "un"
      },
      {
        "ingredientId": "20000000-0000-4000-8000-000000000004",
        "quantity": "1",
        "unit": "xícara"
      }
    ],
    "utensilIds": [
      "30000000-0000-4000-8000-000000000002"
    ],
    "steps": [
      "Bata a farinha, os ovos e o leite até ficar liso.",
      "Aqueça a frigideira e despeje uma concha da massa.",
      "Doure dos dois lados."
    ],
    "allergens": [
      "trigo_centeio_cevada_aveia",
      "ovo",
      "leite",
      "lactose"
    ],
    "allergenState": "source_declared",
    "sourceName": "Receita da dupla (exemplo de teste)",
    "sourceUrl": "https://example.org/crepe-simples"
  }
}

vars:post-response {
  manualProposalId: res.body.id
}

assert {
  res.status: eq 201
  res.body.publicationState: eq proposed
  res.body.origin: eq manual
}
