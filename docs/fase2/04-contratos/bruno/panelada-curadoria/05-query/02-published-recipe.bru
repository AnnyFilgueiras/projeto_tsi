meta {
  name: Receita publicada
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/recipes/{{manualProposalId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  Contrato v1.2.0-2.8 (schema Proposal.id): o prato publicado preserva o mesmo UUID da proposta aprovada como `dishId`.
}
